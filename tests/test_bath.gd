extends SceneTree
func _initialize() -> void:
	var bath := BathSystem.new()
	bath.start()
	bath.press(Vector2.ZERO, 0)
	bath.move(Vector2(20, 0), 1, 0)
	assert(bath.coverage[0] == 0)
	bath.release(1)
	assert(bath.pointer == 0)
	bath.move(Vector2(1000, 0), 0, 0)
	assert(bath.coverage[0] == 0)
	bath.release(0, true)
	assert(bath.stage == 0)
	bath.press(Vector2.ZERO, 0)
	bath.move(Vector2.ZERO, 0, 0)
	assert(bath.coverage[0] == 0)
	bath.cancel()
	bath.move(Vector2(20, 0), 0, 0)
	assert(bath.coverage[0] == 0 and not bath.active)
	print("BATH INPUT: 6 checks passed")
	quit()
